<!--
  Shared MSBuild settings for every project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler; documenting only the non-obvious
         parameters of a member is fine (CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <!-- Mandarina's own version (Filee 1.12.0 is the base); releases pass -p:Version=<tag without the v>. -->
    <Version>0.1.0</Version>
    <Product>Mandarina</Product>
    <!-- Becomes the file description in the version resource, which is what Task Manager and SmartScreen show (not "Filee"). -->
    <AssemblyTitle>Mandarina</AssemblyTitle>
    <Authors>Ignacio Insua; Filee contributors</Authors>
    <Copyright>Copyright (c) 2026 Ignacio Insua (Mandarina) and Filee contributors</Copyright>

    <!-- Single source of truth for the GitHub repository (used by the updater and the About page). Mandarina: its own repository, not Filee's. -->
    <FileeRepositoryUrl>https://github.com/ignFT37/Mandarina</FileeRepositoryUrl>
    <RepositoryUrl>$(FileeRepositoryUrl)</RepositoryUrl>
  </PropertyGroup>

  <!-- Mandarina: bin/obj go to %USERPROFILE%\.mandarina\build instead of the checkout, so a copy inside a synced folder
       (OneDrive, Dropbox...) doesn't upload build output (not under AppData: packaged apps see a private copy of it).
       Set MandarinaBuildRoot (e.g. on the command line, with a trailing slash) to build somewhere else. -->
  <PropertyGroup>
    <MandarinaBuildRoot Condition="'$(MandarinaBuildRoot)' == ''">$(USERPROFILE)\.mandarina\build\</MandarinaBuildRoot>
    <BaseOutputPath>$(MandarinaBuildRoot)$(MSBuildProjectName)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MandarinaBuildRoot)$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <!-- Tests that read repository files look for Filee.slnx above their output; tell them where the checkout is. -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <AssemblyMetadata Include="MandarinaRepoRoot" Value="$(MSBuildThisFileDirectory)" />
  </ItemGroup>
</Project>

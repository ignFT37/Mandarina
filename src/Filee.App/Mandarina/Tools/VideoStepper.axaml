<!-- Mandarina: a small whole-number stepper for the video panels ("split into N parts", "every N seconds"): a round minus, the number
     and a round plus that repeat while they are held. Value, Minimum and Maximum are set by the view that uses it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Filee.App.Mandarina.Tools.VideoStepper">
  <UserControl.Styles>
    <Style Selector="RepeatButton.pstep">
      <Setter Property="Foreground" Value="{DynamicResource PanelInk}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Bg" Width="30" Height="30" CornerRadius="15" Background="#EFE9F0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RepeatButton.pstep:pointerover /template/ Border#Bg">
      <Setter Property="Background" Value="#E3DAE6" />
    </Style>
    <Style Selector="RepeatButton.pstep:disabled /template/ Border#Bg">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </UserControl.Styles>

  <StackPanel Orientation="Horizontal" Spacing="2">
    <RepeatButton x:Name="Less" Classes="pstep" Delay="400" Interval="80" Click="OnLess">
      <PathIcon Width="11" Height="11" Data="M5 11 L19 11 L19 13 L5 13 Z" />
    </RepeatButton>
    <TextBlock x:Name="Number" Classes="pvalue" MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" />
    <RepeatButton x:Name="More" Classes="pstep" Delay="400" Interval="80" Click="OnMore">
      <PathIcon Width="11" Height="11" Data="M11 5 L13 5 L13 11 L19 11 L19 13 L13 13 L13 19 L11 19 L11 13 L5 13 L5 11 L11 11 Z" />
    </RepeatButton>
  </StackPanel>
</UserControl>

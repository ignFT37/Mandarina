<!-- Mandarina: the options of the audio TRIM panel: the waveform with its two handles, the times, play and the silence trim. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Filee.App.Mandarina.Panels"
             xmlns:t="using:Filee.App.Mandarina.Tools"
             x:Class="Filee.App.Mandarina.Tools.TrimAudioView"
             x:DataType="t:TrimAudioPanel">
  <Border Classes="pcard" VerticalAlignment="Top">
    <StackPanel Spacing="14">
      <!-- file name · length -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="pvalue" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="12,0,0,0">
          <TextBlock Classes="plabel" Text="{DynamicResource panel.duration}" />
          <TextBlock Classes="plabel" Text="{Binding DurationText}" />
        </StackPanel>
      </Grid>

      <!-- the waveform -->
      <Border Classes="pwell" Height="150">
        <Panel>
          <p:WaveformView Peaks="{Binding Peaks}" Duration="{Binding Duration}" Start="{Binding Start, Mode=TwoWay}"
                          End="{Binding End, Mode=TwoWay}" Position="{Binding Position, Mode=TwoWay}" Margin="4,10" />
          <TextBlock Text="{DynamicResource panel.trimAudio.loading}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Classes="plabel" IsVisible="{Binding IsLoading}" />
          <TextBlock Text="{Binding LoadError}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                     Margin="24" Classes="plabel" IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Panel>
      </Border>
      <TextBlock Classes="plabel" Text="{DynamicResource panel.trimAudio.hint}" TextWrapping="Wrap" />

      <!-- start · end · kept -->
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="plabel" Text="{DynamicResource panel.trimAudio.start}" />
          <TextBox x:Name="StartBox" Text="{Binding StartText, Mode=OneWay}" LostFocus="OnStartCommit" KeyDown="OnTimeKeyDown" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Classes="plabel" Text="{DynamicResource panel.trimAudio.end}" />
          <TextBox x:Name="EndBox" Text="{Binding EndText, Mode=OneWay}" LostFocus="OnEndCommit" KeyDown="OnTimeKeyDown" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Classes="plabel" Text="{DynamicResource panel.trimAudio.kept}" />
          <TextBlock Classes="pvalue" FontSize="18" Text="{Binding SelectionText}" Margin="0,5,0,0" />
        </StackPanel>
      </Grid>

      <!-- play · silence · reset -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="pchip primary" Click="OnPlay">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Width="11" Height="11" Data="M8 4.5 L19.5 12 L8 19.5 Z" IsVisible="{Binding !IsPlaying}" />
            <PathIcon Width="11" Height="11" Data="M6 6 L18 6 L18 18 L6 18 Z" IsVisible="{Binding IsPlaying}" />
            <TextBlock Text="{DynamicResource panel.trimAudio.play}" IsVisible="{Binding !IsPlaying}" Foreground="White" />
            <TextBlock Text="{DynamicResource panel.trimAudio.stop}" IsVisible="{Binding IsPlaying}" Foreground="White" />
          </StackPanel>
        </Button>
        <Button Classes="pchip" Click="OnSilence" Content="{DynamicResource panel.trimAudio.silence}" />
        <Button Classes="pchip" Click="OnReset" Content="{DynamicResource panel.trimAudio.reset}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
